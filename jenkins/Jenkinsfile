
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {

        // STAGE 1: CHECKOUT
        stage('Checkout') {
            steps {
                echo 'Checking out CineVault source code'
                checkout scm
            }
        }

        // STAGE 2: ENVIRONMENT CHECK
        stage('Environment Check') {
            steps {
                echo 'Checking build environment'

                sh 'docker --version'
                sh 'aws --version'
                sh 'trivy --version'
                sh 'git --version'
                sh 'node --version'
                sh 'npm --version'
            }
        }

        // STAGE 3: AUTOMATED TESTING
        stage('Automated Testing') {
            steps {
                dir('backend') {
                    echo 'Installing backend dependencies'

                    sh 'npm ci'

                    echo 'Running Jest automated tests'

                    sh 'npm test -- --coverage'
                }
            }

            post {
                always {
                    dir('backend') {
                        script {
                            if (fileExists('coverage/junit.xml')) {
                                echo 'JUnit report found'
                            }

                            if (fileExists('coverage/lcov.info')) {
                                echo 'Coverage report generated'
                            }
                        }
                    }
                }
            }
        }

        // STAGE 4: BUILD BACKEND
        stage('Build Backend') {
            steps {
                echo 'Building CineVault backend Docker image'

                sh '''
                    docker build \
                    -t cinevault-backend:${BUILD_NUMBER} \
                    ./backend
                '''
            }
        }

        // STAGE 5: BUILD FRONTEND
        stage('Build Frontend') {
            steps {
                echo 'Building CineVault frontend Docker image'

                sh '''
                    docker build \
                    -t cinevault-frontend:${BUILD_NUMBER} \
                    ./frontend
                '''
            }
        }
    }

    post {
        success {
            echo 'CineVault CI pipeline completed successfully!'
        }

        failure {
            echo 'CineVault CI pipeline failed. Check the logs.'
        }

        always {
            echo 'CineVault Jenkins pipeline execution finished.'
        }
    }
}
